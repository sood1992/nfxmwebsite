# Neofox Media - Git Ignore

# Editor Database
editor/database/*.db
editor/database/*.db-journal

# Editor Backups
editor/backups/*.html

# Editor Logs
editor/logs/*.log

# Uploaded Media (images should be uploaded directly to server)
# Uncomment if you don't want to track images in Git
# images/*
# !images/.gitkeep

# System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~

# IDE Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Temporary Files
*.tmp
*.temp
*.cache

# Backup Files
*.bak
*.backup

# MacOS
__MACOSX/

# Archive Files
*.zip
*.tar
*.tar.gz
*.rar

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Files
.env
.env.local
.env.production

# PHP Composer (if used)
/vendor/
composer.lock

# Node Modules (if used)
node_modules/
package-lock.json

# Test Files
/test/
/tests/
phpunit.xml
.phpunit.result.cache
