# Neofox Editor - Simple Configuration

# Deny access to sensitive files
<FilesMatch "\.(db|sqlite|log|bak)$">
    Require all denied
</FilesMatch>

# Protect config files
<Files "config.php">
    Require all denied
</Files>

# Allow access to assets
<FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg)$">
    Require all granted
</FilesMatch>

# Allow PHP files
<FilesMatch "\.(php)$">
    Require all granted
</FilesMatch>

# Prevent directory browsing
Options -Indexes
